{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.8.0" }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/"
        },
        {
            "src": "/css/(.*)",
            "dest": "/public/css/"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/"
        },
        {
            "src": "/js/(.*)",
            "dest": "/public/js/"
        },
        {
            "src": "/vendors/(.*)",
            "dest": "/public/vendors/"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:iTKulNFdtQ5nUMr4tbZFOKQcYcYMj4JZ1W1CWDk8RC8=",
        "APP_URL": "https://photobooth-masapit-6ffc6hrdu-rafliramadhani11s-projects.vercel.app/",

        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "APP_MAINTENANCE_DRIVER": "file",

        "VIEW_COMPILED_PATH": "/tmp",

        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",

        "LOG_CHANNEL": "stderr"
    }
}
